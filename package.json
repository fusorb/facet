{
  "name": "@fusorb/facet",
  "version": "2.0.0",
  "private": true,
  "description": "Domain-customizable auth-first component system",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "release": "pnpm build && pnpm changeset publish",
    "version-packages": "changeset version && node scripts/sync-readme-versions.mjs && node packages/registry/src/scan.mjs",
    "dev:landing": "pnpm -F @fusorb/facet-landing dev",
    "dev:docs-site": "pnpm -F @fusorb/facet-docs-site dev",
    "dev:all": "turbo run dev --filter=@fusorb/facet-landing --filter=@fusorb/facet-docs-site --filter=@fusorb/facet-playground",
    "dev:playground": "pnpm -F @fusorb/facet-playground dev",
    "build:docs": "pnpm -F @fusorb/facet-docs build && pnpm -F @fusorb/facet-docs-site build",
    "lint": "eslint . --ext .ts,.tsx --ignore-pattern dist --ignore-pattern .next",
    "format": "prettier --write \"**/*.{ts,tsx,json,css,md}\" --ignore-path .gitignore",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "check:components": "node scripts/check-component-flexibility.mjs",
    "check:examples": "node scripts/check-examples.mjs",
    "check:jsdoc": "node scripts/check-component-jsdoc.mjs",
    "check:docs": "node scripts/check-docs-inventory.mjs",
    "check:docs-content": "node scripts/check-docs-content.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:landing-sections": "node scripts/check-landing-sections.mjs",
    "check:perf-budgets": "node scripts/check-perf-budgets.mjs",
    "check:consumer-matrix": "node scripts/check-consumer-matrix.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "check:icons": "node scripts/gen-icon-map.mjs --check",
    "check:sdk-coverage": "node scripts/audit-sdk-coverage.cjs",
    "check:sdk-drift": "node scripts/check-sdk-table-drift.mjs",
    "gen:site-data": "node scripts/gen-site-data.mjs",
    "gen:changelog": "node scripts/gen-changelog.mjs",
    "gen:changeset": "node scripts/gen-changeset.mjs",
    "sync:tracker": "node scripts/gen-tracker.mjs",
    "sync:readme": "node scripts/sync-readme-versions.mjs",
    "sync:registry": "node packages/registry/src/scan.mjs",
    "check:motion-drift": "node packages/motion/scripts/check-motion-drift.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "check:engine-purity": "node scripts/check-engine-purity.mjs",
    "check:registry": "node scripts/check-registry.mjs",
    "check:pins": "node scripts/check-pins.mjs",
    "check:surfaces": "node scripts/check-surfaces.mjs",
    "check:readme": "node scripts/check-readme.mjs",
    "check:layout-skeleton-parity": "node scripts/check-layout-skeleton-parity.mjs",
    "update:registry": "node packages/registry/src/scan.mjs",
    "audit:motion-parity": "node scripts/audit-motion-parity.mjs",
    "check:all": "pnpm check:components && pnpm check:examples && pnpm check:jsdoc && pnpm check:docs && pnpm check:docs-content && pnpm check:content && pnpm check:claims && pnpm check:landing-sections && pnpm check:perf-budgets && pnpm check:consumer-matrix && pnpm check:a11y && pnpm check:icons && pnpm check:sdk-coverage && pnpm check:sdk-drift && pnpm check:motion-drift && pnpm check:boundaries && pnpm check:engine-purity && pnpm check:registry && pnpm check:pins && pnpm check:surfaces && pnpm check:readme && pnpm check:layout-skeleton-parity && pnpm audit:motion-parity && pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm sandbox:e2e",
    "build:turbo": "turbo run build",
    "test:turbo": "turbo run test",
    "typecheck:turbo": "turbo run typecheck",
    "sandbox:e2e": "node scripts/sandbox-e2e.mjs",
    "lint:turbo": "turbo run lint",
    "analyze": "pnpm -r run build:analyze && pnpm analyze:apps",
    "analyze:apps": "pnpm --filter @fusorb/facet-landing analyze",
    "nuke": "pnpm clean --lockfile"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^9.39.5",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/expect": "4.1.12",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.0",
    "prettier": "^3.8.3",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "turbo": "^2.11.10",
    "typescript": "^5",
    "typescript-eslint": "^8.65.0",
    "vite-bundle-visualizer": "^1.2.1",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@12.18.0"
}
