{
  "name": "@fusorb/facet-motion",
  "version": "1.0.0",
  "description": "Domain-customizable animation engine: generator-driven core (tween + spring), observable motion values, CSS driver with prefers-reduced-motion, a 15-family generative registry, and thin React bindings. Wired to @fusorb/facet-tokens CSS custom properties.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:analyze": "tsup --metafile",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:motion-drift": "node scripts/check-motion-drift.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusorb/facet.git",
    "directory": "packages/motion"
  },
  "bugs": {
    "url": "https://github.com/fusorb/facet/issues"
  },
  "homepage": "https://github.com/fusorb/facet",
  "license": "MIT",
  "keywords": [
    "animation",
    "motion",
    "react",
    "design-system",
    "tailwindcss",
    "tween",
    "spring",
    "generative"
  ],
  "dependencies": {
    "@fusorb/facet-tokens": "workspace:*",
    "@fusorb/facet-utils": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.4",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
