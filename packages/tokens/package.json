{
  "name": "@fusorb/facet-tokens",
  "version": "1.2.0",
  "description": "Design tokens: Alpha Palette colors, typography, spacing, surfaces, and sub-brand accents in OKLCH, as CSS variables and a Tailwind v4 theme.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./index.css": "./dist/index.css",
    "./tokens.css": "./dist/tokens.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean && node -e \"require('fs').cpSync('src/tokens.css', 'dist/tokens.css'); require('fs').cpSync('src/tailwind.css', 'dist/tailwind.css'); require('fs').cpSync('src/index.css', 'dist/index.css')\" && node minify-css.cjs",
    "build:analyze": "tsup src/index.ts --format esm --dts --metafile",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusorb/facet.git",
    "directory": "packages/tokens"
  },
  "bugs": {
    "url": "https://github.com/fusorb/facet/issues"
  },
  "homepage": "https://github.com/fusorb/facet",
  "license": "MIT",
  "keywords": [
    "design-tokens",
    "alpha-palette",
    "ui",
    "oklch"
  ],
  "devDependencies": {
    "esbuild": "^0.28.2",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "dependencies": {
    "tw-animate-css": "^1.4.0"
  },
  "engines": {
    "node": ">=20"
  }
}
