{
  "name": "@fusorb/facet-layout",
  "version": "1.4.2",
  "description": "Domain-configurable app shell for the ArcevoCirqle ecosystem: Sidebar, Topbar, AuthLayout, ConsoleLayout, LandingLayout, PageHeader, TenantSwitcher, and 5 domain presets (fintech, med, edu, enterprise, default).",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "build:analyze": "tsup --metafile",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusorb/facet.git",
    "directory": "packages/layout"
  },
  "bugs": {
    "url": "https://github.com/fusorb/facet/issues"
  },
  "homepage": "https://facet.arcevocirqle.com.ng",
  "license": "MIT",
  "keywords": [
    "layout",
    "sidebar",
    "topbar",
    "app-shell",
    "arcevocirqle",
    "react",
    "dashboard"
  ],
  "dependencies": {
    "@fusorb/facet-auth": "workspace:*",
    "@fusorb/facet-components": "workspace:*"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
