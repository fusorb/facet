{
  "name": "@fusorb/facet-utils",
  "version": "0.1.0",
  "description": "Shared styling utilities for Facet packages (cn).",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusorb/facet.git",
    "directory": "packages/utils"
  },
  "bugs": {
    "url": "https://github.com/fusorb/facet/issues"
  },
  "homepage": "https://github.com/fusorb/facet",
  "license": "MIT",
  "keywords": [
    "utilities",
    "classnames",
    "tailwind-merge",
    "design-system"
  ],
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
