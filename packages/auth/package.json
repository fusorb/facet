{
  "name": "@fusorb/facet-auth",
  "version": "1.2.3",
  "description": "Domain-customizable auth components for the ArcevoCirqle ecosystem: ArcProvider, SignIn/SignUp, Guard, MfaDialog, and 5 domain presets (fintech, med, edu, enterprise, default). Wired to @fusorb/facet-sdk.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "build:analyze": "tsup --metafile",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fusorb/facet.git",
    "directory": "packages/auth"
  },
  "bugs": {
    "url": "https://github.com/fusorb/facet/issues"
  },
  "homepage": "https://facet.arcevocirqle.com.ng",
  "license": "MIT",
  "keywords": [
    "authentication",
    "react",
    "arcevocirqle",
    "mfa",
    "passkeys",
    "oauth",
    "auth-ui"
  ],
  "dependencies": {
    "@fusorb/facet-components": "workspace:*",
    "@fusorb/facet-sdk": "workspace:*",
    "@hookform/resolvers": "^5.5.7",
    "react-hook-form": "^7.83.0",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "react": "^19",
    "react-dom": "^19",
    "tsup": "^8.5.1",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20"
  }
}
